APP_ENV=development

DATABASE_URL=postgresql+psycopg://vps:vps@db:5432/vps
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# LLM provider: "anthropic" or "groq" (users can override per-account in Settings)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=replace-me

# Groq Cloud (https://console.groq.com) — OpenAI-compatible, very fast streaming
GROQ_API_KEY=replace-me
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model names for the active provider.
#   Anthropic examples: claude-sonnet-4-5, claude-haiku-4-5
#   Groq examples:      llama-3.3-70b-versatile, llama-3.1-8b-instant,
#                       openai/gpt-oss-120b, moonshotai/kimi-k2-instruct
LLM_EXTRACTION_MODEL=
LLM_SCENARIO_MODEL=
LLM_PATIENT_MODEL=
LLM_SCORING_MODEL=
LLM_FEEDBACK_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

CORS_ORIGINS=http://localhost:5173

API_PORT=8000
FRONTEND_PORT=5173
DB_PORT=5432
REDIS_PORT=6379

MAX_PDF_SIZE_MB=50
MAX_PDF_PAGES=300
MAX_SESSION_TURNS=40

STORAGE_ROOT=storage
UPLOAD_RATE_LIMIT_COUNT=5
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600

SCENARIO_DIFFICULTIES=easy,medium,hard
SCENARIO_ESTIMATED_DURATION_MINUTES=15

SESSION_TIME_LIMIT_SECONDS=2700
CONVERSATION_CONTEXT_TURNS=12
MESSAGE_RATE_LIMIT_COUNT=20
MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
SESSION_START_RATE_LIMIT_COUNT=10
SESSION_START_RATE_LIMIT_WINDOW_SECONDS=60
TURN_LOCK_TTL_SECONDS=300

LLM_SETTINGS_SECRET=
MAX_EXAMINATIONS_PER_SESSION=20
MAX_INVESTIGATIONS_PER_SESSION=20
SCORING_CANDIDATE_COUNT=10
SCORING_MAX_ITEMS_PER_CALL=25
SCORING_WAIT_TIMEOUT_SECONDS=120
CRITICAL_MISS_PENALTY=10
PROGRESS_WINDOW_SESSIONS=10

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
